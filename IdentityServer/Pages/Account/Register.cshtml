<div class="min-h-screen bg-[#050505] flex items-center justify-center p-4">
    <div class="w-full max-w-[400px] bg-[#0d0d0d] border border-zinc-800/50 rounded-2xl p-8 shadow-2xl">

        <div class="flex justify-center mb-6">
            <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-lg shadow-white/5">
                <span class="text-black font-bold text-xl">!</span>
            </div>
        </div>

        <div class="text-center mb-8">
            <h1 class="text-xl font-semibold text-white">
                Добро пожаловать в <span class="text-[#84cc16]">AutoPanel</span>
            </h1>
            <div class="mt-4 space-y-1">
                <p class="text-sm text-zinc-200 font-medium">Создать аккаунт</p>
                <p class="text-[11px] text-zinc-500 leading-relaxed px-4">
                    Введите свои данные ниже, чтобы создать учетную запись
                </p>
            </div>
        </div>


        <form method="post" class="space-y-4">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bg-red-500/10 border border-red-500/20 text-red-500 text-[11px] p-3 rounded-lg text-center">
                    @Model.ErrorMessage
                </div>
            }
            <div class="space-y-2">
                <label asp-for="Input.Name" class="text-xs font-medium text-zinc-400 ml-1">Имя</label>
                <input asp-for="Input.Name" type="text" placeholder="Никита" class="w-full bg-zinc-900/50 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-200 placeholder:text-zinc-600 focus:outline-none focus:ring-1 focus:ring-[#84cc16]/50 focus:border-[#84cc16]/50 transition-all" />
                <span asp-validation-for="Input.Name" class="text-red-500 text-xs"></span>
            </div>
            <div class="space-y-2">
                <label asp-for="Input.Login" class="text-xs font-medium text-zinc-400 ml-1">Логин</label>
                <input asp-for="Input.Login" type="text" placeholder="login" class="w-full bg-zinc-900/50 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-200 placeholder:text-zinc-600 focus:outline-none focus:ring-1 focus:ring-[#84cc16]/50 focus:border-[#84cc16]/50 transition-all" />
                <span asp-validation-for="Input.Login" class="text-red-500 text-xs"></span>
            </div>
            <div class="space-y-2">
                <label asp-for="Input.Email" class="text-xs font-medium text-zinc-400 ml-1">Email</label>
                <input asp-for="Input.Email" type="email" placeholder="m@example.com" class="w-full bg-zinc-900/50 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-200 placeholder:text-zinc-600 focus:outline-none focus:ring-1 focus:ring-[#84cc16]/50 focus:border-[#84cc16]/50 transition-all" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs"></span>
            </div>
            <div class="space-y-2">
                <label asp-for="Input.Password" class="text-xs font-medium text-zinc-400 ml-1">Пароль</label>
                <input asp-for="Input.Password" type="password" class="w-full bg-zinc-900/50 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-200 focus:outline-none focus:ring-1 focus:ring-[#84cc16]/50 focus:border-[#84cc16]/50 transition-all" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs"></span>
            </div>
            <div class="space-y-2">
                <label asp-for="Input.ConfirmPassword" class="text-xs font-medium text-zinc-400 ml-1">Подтвердите пароль</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="w-full bg-zinc-900/50 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-200 focus:outline-none focus:ring-1 focus:ring-[#84cc16]/50 focus:border-[#84cc16]/50 transition-all" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs"></span>
            </div>
            <button type="submit" class="w-full bg-[#84cc16] hover:bg-[#a3e635] text-black font-semibold py-2.5 rounded-lg text-sm transition-colors mt-4 shadow-lg shadow-[#84cc16]/10">Зарегистрироваться</button>
        </form>

        <div class="mt-8 text-center">
            <p class="text-[11px] text-zinc-600">
                У вас уже есть аккаунт?
                <a routerLink="/login" class="text-zinc-400 hover:text-white underline underline-offset-4 transition-colors">Войти</a>
            </p>
        </div>

    </div>
</div>
